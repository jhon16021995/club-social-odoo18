<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_club_member_absence_return_wizard_form"
            model="ir.ui.view">
        <field name="name">club.member.absence.return.wizard.form</field>
        <field name="model">club.member.absence.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar retorno de Socio Ausente">
                <group string="Socio">
                    <field name="member_id"/>
                    <field name="member_code"/>
                    <field name="current_member_state"/>
                    <field name="expected_return_date"/>
                </group>
                <group string="Datos del retorno">
                    <field name="effective_date"/>
                    <field name="reason"
                           placeholder="Indique el motivo del retorno..."/>
                </group>
                <div class="alert alert-info" role="alert">
                    El retorno restablece el estado Activo sin crear
                    otro período de membresía ni otro Certificado.
                    La operación quedará registrada en el Kardex.
                </div>
                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Confirmar retorno"
                            class="btn-primary"
                            confirm="¿Confirma el retorno del Socio?"/>
                    <button string="Cancelar"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
