<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record
        id="view_club_beneficiary_transition_wizard_form"
        model="ir.ui.view"
    >
        <field name="name">
            club.beneficiary.transition.wizard.form
        </field>

        <field name="model">club.beneficiary.transition.wizard</field>

        <field name="arch" type="xml">
            <form string="Gestionar vínculo de Beneficiario">
                <field name="operation" invisible="1"/>

                <group string="Vínculo de origen">
                    <field name="person_id"/>
                    <field name="current_member_id"/>
                    <field name="current_relationship"/>
                </group>

                <group
                    string="Finalización"
                    invisible="operation == 'new_link'"
                >
                    <field
                        name="end_date"
                        required="operation != 'new_link'"
                    />

                    <field
                        name="reason"
                        required="operation != 'new_link'"
                        placeholder="Explique el motivo de la operación..."
                    />
                </group>

                <group
                    string="Nuevo vínculo"
                    invisible="operation == 'finalize'"
                >
                    <field
                        name="new_member_id"
                        required="operation != 'finalize'"
                        options="{
                            'no_create': True,
                            'no_open': True
                        }"
                    />

                    <field
                        name="relationship"
                        required="operation != 'finalize'"
                    />

                    <field
                        name="relationship_detail"
                        invisible="relationship != 'family_dependent'"
                        required="
                            operation != 'finalize'
                            and relationship == 'family_dependent'
                        "
                    />

                    <field
                        name="special_condition"
                        required="operation != 'finalize'"
                    />

                    <field
                        name="start_date"
                        required="operation != 'finalize'"
                    />
                </group>

                <footer>
                    <button
                        name="action_confirm"
                        string="Finalizar vínculo"
                        type="object"
                        class="btn-primary"
                        invisible="operation != 'finalize'"
                    />

                    <button
                        name="action_confirm"
                        string="Confirmar reasignación"
                        type="object"
                        class="btn-primary"
                        invisible="operation != 'reassign'"
                    />

                    <button
                        name="action_confirm"
                        string="Crear nuevo vínculo"
                        type="object"
                        class="btn-primary"
                        invisible="operation != 'new_link'"
                    />

                    <button
                        string="Cancelar"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>

    <!-- Acciones en la ficha general del Beneficiario. -->

    <record
        id="view_club_beneficiary_form_transition_actions"
        model="ir.ui.view"
    >
        <field name="name">
            club.beneficiary.form.transition.actions
        </field>

        <field name="model">club.beneficiary</field>

        <field
            name="inherit_id"
            ref="view_club_beneficiary_form"
        />

        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="%(action_club_person_identity_correction_wizard)d"
                    type="action"
                    string="Corregir identidad"
                    groups="club_membership.group_club_identity_correction"
                    context="{
                        'default_person_id': person_id
                    }"
                    invisible="not person_id"
                />

                <button
                    name="action_open_reassign_wizard"
                    type="object"
                    string="Reasignar / cambiar vínculo"
                    invisible="state == 'finalized'"
                />

                <button
                    name="action_open_finalize_wizard"
                    type="object"
                    string="Finalizar vínculo"
                    invisible="state == 'finalized'"
                    confirm="
                        El vínculo actual quedará histórico.
                        ¿Desea continuar?
                    "
                />

                <button
                    name="action_open_new_link_wizard"
                    type="object"
                    string="Crear nuevo vínculo"
                    invisible="
                        state != 'finalized'
                        or converted_member_id
                    "
                />
            </xpath>
        </field>
    </record>

    <!-- Acciones cuando se abre desde la ficha del Socio. -->

    <record
        id="view_partner_form_club_beneficiary_transition_actions"
        model="ir.ui.view"
    >
        <field name="name">
            res.partner.form.club.beneficiary.transition.actions
        </field>

        <field name="model">res.partner</field>

        <field
            name="inherit_id"
            ref="view_partner_form_club_membership"
        />

        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='club_beneficiary_ids']/form/sheet"
                position="before"
            >
                <header>
                    <field
                        name="converted_member_id"
                        invisible="1"
                    />

                    <button
                        name="%(action_club_person_identity_correction_wizard)d"
                        type="action"
                        string="Corregir identidad"
                        groups="club_membership.group_club_identity_correction"
                        context="{
                            'default_person_id': person_id
                        }"
                        invisible="not person_id"
                    />

                    <button
                        name="action_convert_to_member"
                        type="object"
                        string="Convertir en Socio"
                        class="oe_highlight"
                        invisible="converted_member_id"
                        confirm="
                            La persona será dada de alta como Socio
                            reutilizando su identidad y carnet.
                            ¿Desea continuar?
                        "
                    />

                    <button
                        name="action_open_reassign_wizard"
                        type="object"
                        string="Reasignar / cambiar vínculo"
                        invisible="state == 'finalized'"
                    />

                    <button
                        name="action_open_finalize_wizard"
                        type="object"
                        string="Finalizar vínculo"
                        invisible="state == 'finalized'"
                        confirm="
                            El vínculo actual quedará histórico.
                            ¿Desea continuar?
                        "
                    />

                    <button
                        name="action_open_new_link_wizard"
                        type="object"
                        string="Crear nuevo vínculo"
                        invisible="
                            state != 'finalized'
                            or converted_member_id
                        "
                    />
                </header>
            </xpath>
        </field>
    </record>
</odoo>
