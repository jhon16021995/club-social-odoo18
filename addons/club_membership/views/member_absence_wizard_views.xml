<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_club_member_absence_wizard_form" model="ir.ui.view">
        <field name="name">club.member.absence.wizard.form</field>
        <field name="model">club.member.absence.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar ausencia de Socio">
                <group string="Socio">
                    <field name="member_id"/>
                    <field name="member_code"/>
                    <field name="current_member_state"/>
                </group>
                <group string="Datos de la ausencia">
                    <field name="effective_date"/>
                    <field name="expected_return_date"/>
                    <field name="reason"
                           placeholder="Indique el motivo de la ausencia..."/>
                </group>
                <div class="alert alert-info" role="alert">
                    La ausencia conserva el período de membresía y el
                    Certificado Patrimonial. La fecha prevista de retorno
                    es informativa y no genera un retorno automático.
                </div>
                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Confirmar ausencia"
                            class="btn-primary"
                            confirm="¿Confirma la ausencia del Socio?"/>
                    <button string="Cancelar"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
