<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_club_member_withdrawal_wizard_form" model="ir.ui.view">
        <field name="name">club.member.withdrawal.wizard.form</field>
        <field name="model">club.member.withdrawal.wizard</field>
        <field name="arch" type="xml">
            <form string="Retirar / dar de baja Socio">
                <group>
                    <group string="Socio">
                        <field name="member_id"/>
                        <field name="member_code"/>
                        <field name="current_member_state"/>
                        <field name="certificate_id"/>
                        <field
                            name="certificate_state"
                            invisible="not certificate_id"
                        />
                    </group>

                    <group string="Impacto sobre Beneficiarios">
                        <field name="active_beneficiary_count"/>
                        <field name="blocked_beneficiary_count"/>
                    </group>
                </group>

                <separator string="Datos del retiro"/>

                <group>
                    <field name="effective_date"/>
                    <field
                        name="reason"
                        placeholder="Indique el motivo administrativo del retiro..."
                    />
                </group>

                <div class="alert alert-warning" role="alert">
                    <strong>Esta operación conserva el historial.</strong>
                    El Socio pasará a Pasivo. Si su Certificado Patrimonial
                    está Activo, pasará a Pasivo. Los Beneficiarios activos
                    serán bloqueados; los ya bloqueados o finalizados no
                    serán modificados. Este proceso no registra pagos,
                    devoluciones ni movimientos contables.
                </div>

                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirmar retiro"
                        class="btn-primary"
                        confirm="¿Confirma el retiro del Socio?"
                    />
                    <button
                        string="Cancelar"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
