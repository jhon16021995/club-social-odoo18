<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record
        id="view_club_client_to_beneficiary_wizard_form"
        model="ir.ui.view"
    >
        <field name="name">club.client.to.beneficiary.wizard.form</field>
        <field name="model">club.client.to.beneficiary.wizard</field>
        <field name="arch" type="xml">
            <form string="Convertir Cliente en Beneficiario">
                <group>
                    <group string="Persona">
                        <field name="person_id"/>
                        <field name="member_id"/>
                    </group>

                    <group string="Vínculo">
                        <field name="relationship"/>
                        <field
                            name="relationship_detail"
                            invisible="
                                relationship != 'family_dependent'
                            "
                            required="
                                relationship == 'family_dependent'
                            "
                            placeholder="
                                Especifique el vínculo familiar
                            "
                        />
                        <field name="special_condition"/>
                        <field name="start_date"/>
                    </group>
                </group>

                <group>
                    <field
                        name="observations"
                        placeholder="
                            Observaciones administrativas opcionales...
                        "
                    />
                </group>

                <div class="alert alert-info" role="alert">
                    La conversión conservará la misma Persona y su carnet.
                    Se retirará la condición de Cliente y se creará el
                    vínculo vigente como Beneficiario del Socio titular.
                </div>

                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirmar conversión"
                        class="btn-primary"
                    />
                    <button
                        string="Cancelar"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
