<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         CATEGORÍA DE SEGURIDAD DEL CLUB
         ============================================================ -->

    <record id="module_category_club_social" model="ir.module.category">
        <field name="name">Club Social</field>
        <field name="description">
            Permisos específicos del Sistema de Gestión del Club Social.
        </field>
        <field name="sequence">30</field>
    </record>

    <!-- ============================================================
         AUDITORÍA DE IDENTIDAD
         ============================================================ -->

    <record id="group_club_identity_history" model="res.groups">
        <field name="name">Consultar historial de identidad</field>
        <field
            name="category_id"
            ref="club_membership.module_category_club_social"
        />
    </record>

    <record id="group_club_identity_correction" model="res.groups">
        <field name="name">Corregir identidad</field>
        <field
            name="category_id"
            ref="club_membership.module_category_club_social"
        />
        <field
            name="implied_ids"
            eval="[(4, ref('club_membership.group_club_identity_history'))]"
        />
    </record>

    <!-- ============================================================
         CORRECCIÓN DE ALTA ERRÓNEA DE SOCIO
         ============================================================ -->

    <record
        id="group_club_member_registration_correction"
        model="res.groups"
    >
        <field name="name">
            Corregir alta errónea de Socio
        </field>
        <field
            name="category_id"
            ref="club_membership.module_category_club_social"
        />
    </record>

    <!-- ============================================================
         RETIRO / BAJA VOLUNTARIA DE SOCIO
         ============================================================ -->

    <record id="group_club_member_withdrawal" model="res.groups">
        <field name="name">Retirar / dar de baja Socio</field>
        <field
            name="category_id"
            ref="club_membership.module_category_club_social"
        />
    </record>

    <record id="group_club_member_reactivation" model="res.groups">
        <field name="name">Reactivar Socio Pasivo</field>
        <field
            name="category_id"
            ref="club_membership.module_category_club_social"
        />
    </record>


    <!-- ============================================================
         BAJA DEFINITIVA DE MEMBRESIA
         ============================================================ -->

    <record id="group_club_membership_end" model="res.groups">
        <field name="name">Finalizar membresía definitivamente</field>
        <field
            name="category_id"
            ref="club_membership.module_category_club_social"
        />
    </record>

    <!-- ============================================================
         REINGRESO DE EX-SOCIO COMO SOCIO
         ============================================================ -->

    <record id="group_club_member_reentry" model="res.groups">
        <field name="name">Reingresar Ex-Socio como Socio</field>
        <field
            name="category_id"
            ref="club_membership.module_category_club_social"
        />
    </record>

    <!-- ============================================================
         CONVERSIÓN CONTROLADA DE CLIENTE A SOCIO
         ============================================================ -->

    <record id="group_club_client_to_member" model="res.groups">
        <field name="name">Convertir Cliente en Socio</field>
        <field
            name="category_id"
            ref="club_membership.module_category_club_social"
        />
    </record>

    <!-- ============================================================
         CONVERSIÓN CONTROLADA DE CLIENTE A BENEFICIARIO
         ============================================================ -->

    <record id="group_club_client_to_beneficiary" model="res.groups">
        <field name="name">Convertir Cliente en Beneficiario</field>
        <field
            name="category_id"
            ref="club_membership.module_category_club_social"
        />
    </record>

    <!--
        Durante esta fase los administradores del sistema reciben
        automáticamente los permisos especiales de corrección.

        Los perfiles funcionales definitivos del Club se configurarán
        posteriormente sin depender de base.group_user.
    -->

    <record id="base.group_system" model="res.groups">
        <field
            name="implied_ids"
            eval="[
                (4, ref('club_membership.group_club_identity_correction')),
                (
                    4,
                    ref(
                        'club_membership.'
                        'group_club_member_registration_correction'
                    )
                ),
                (
                    4,
                    ref(
                        'club_membership.'
                        'group_club_member_withdrawal'
                    )
                ),
                (
                    4,
                    ref(
                        'club_membership.'
                        'group_club_member_reactivation'
                    )
                ),
                (
                    4,
                    ref(
                        'club_membership.'
                        'group_club_membership_end'
                    )
                )
            ]"
        />
    </record>



    <record id="base.group_system" model="res.groups">
        <field
            name="implied_ids"
            eval="[
                (
                    4,
                    ref(
                        'club_membership.'
                        'group_club_member_reentry'
                    )
                ),
                (
                    4,
                    ref(
                        'club_membership.'
                        'group_club_client_to_member'
                    )
                ),
                (
                    4,
                    ref(
                        'club_membership.'
                        'group_club_client_to_beneficiary'
                    )
                )
            ]"
        />
    </record>

    <!-- ============================================================
         CONVERSIÓN CONTROLADA DE BENEFICIARIO A CLIENTE
         ============================================================ -->

    <record id="group_club_beneficiary_to_client" model="res.groups">
        <field name="name">Convertir Beneficiario en Cliente</field>
        <field
            name="category_id"
            ref="club_membership.module_category_club_social"
        />
    </record>

    <record id="base.group_system" model="res.groups">
        <field
            name="implied_ids"
            eval="[
                (
                    4,
                    ref(
                        'club_membership.'
                        'group_club_beneficiary_to_client'
                    )
                )
            ]"
        />
    </record>


    <!-- ============================================================
         CONVERSIÓN CONTROLADA DE EX-SOCIO A CLIENTE
         ============================================================ -->
    <record id="group_club_former_member_to_client" model="res.groups">
        <field name="name">Convertir Ex-Socio en Cliente</field>
        <field
            name="category_id"
            ref="club_membership.module_category_club_social"
        />
    </record>

    <record id="base.group_system" model="res.groups">
        <field
            name="implied_ids"
            eval="[
                (
                    4,
                    ref(
                        'club_membership.'
                        'group_club_former_member_to_client'
                    )
                )
            ]"
        />
    </record>

</odoo>
