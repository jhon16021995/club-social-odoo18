<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record
        id="ir_cron_block_age_limit_beneficiaries"
        model="ir.cron"
    >
        <field name="name">
            Club Social: Finalizar beneficiarios por límite de edad
        </field>

        <field
            name="model_id"
            ref="model_club_beneficiary"
        />

        <field name="state">code</field>

        <field name="code">
            model._cron_finalize_age_limit_beneficiaries()
        </field>

        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
